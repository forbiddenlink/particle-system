{
  "name": "particle-system",
  "version": "1.0.6",
  "private": true,
  "description": "3D particle system with WebGPU compute shaders and a WebGL2 fallback, presets, pointer forces, audio reactivity, trails, and recording",
  "author": "Nova Particles Team",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @nova-particles/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "preview": "pnpm --filter @nova-particles/web preview",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "biome:check": "biome check .",
    "biome:fix": "biome check . --write",
    "biome:format": "biome format . --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.34.5"
  },
  "packageManager": "pnpm@10.34.7",
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.25.0 <1",
      "rollup": ">=4.59.0 <5",
      "minimatch": ">=10.2.3 <11",
      "vite": ">=8.2.4 <9",
      "picomatch": ">=4.0.4 <5",
      "lodash": ">=4.18.0 <5",
      "protobufjs": ">=7.5.5 <8",
      "fast-uri": ">=3.1.2 <4",
      "axios": ">=1.13.5 <2",
      "hono": ">=4.13.0 <5",
      "flatted": ">=3.3.4 <4",
      "undici": ">=7.0.0 <8",
      "source-map-js@1": ">=1.2.2 <2.0.0"
    }
  }
}
